<%- include('./partials/header') %>
    <div class="page-wrapper">

        <main>
            <section>
                <div class="register-container">
                    <% if (typeof errorMessage !=="undefined" && errorMessage) { %>
                        <div class="error-register">
                            <%= errorMessage %>
                        </div>
                        <% } %>
                            <form action="/register" method="POST">
                                <div class="input-group">
                                    <label for="nickname" class="username-register">Pseudo</label>
                                    <input type="text" name="nickname" id="nickname" class="class-username"
                                        value="<%= typeof nickname !== 'undefined' ? nickname : '' %>" required />
                                </div>

                                <div class="input-group">
                                    <label for="email" class="mail-register">Email</label>
                                    <input type="email" name="email" id="email" class="class-email"
                                        value="<%= typeof email !== 'undefined' ? email : '' %>" required />
                                </div>

                                <div class="input-group">
                                    <label for="password" class="password-register">Mot de passe</label>
                                    <input type="password" name="password" id="password" class="class-password"
                                        pattern="^(?=.*[A-Za-z])(?=.*\d)[^\s]{8,}$"
                                        title="Au moins 8 caractères, avec au moins une lettre et un chiffre"
                                        required />
                                </div>

                                <div class="input-group">
                                    <label for="confirmedPassword" class="confirm-password-register">
                                        Confirmation de mot de passe
                                    </label>
                                    <input type="password" name="confirmedPassword" id="confirmedPassword"
                                        class="class-confirm-password" pattern="^(?=.*[A-Za-z])(?=.*\d)[^\s]{8,}$"
                                        title="Au moins 8 caractères, avec au moins une lettre et un chiffre"
                                        required />
                                </div>

                                <button type="submit" class="register-button">S'inscrire</button>
                            </form>
                </div>
            </section>
        </main>


    </div>
    <%- include('./partials/footer') %>